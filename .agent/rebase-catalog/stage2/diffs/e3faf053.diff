+        </div>
+
+        <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">
+          <div className="rounded-lg border border-black/10 dark:border-white/10 p-3">
+            <p className="text-xs text-text-muted mb-0.5">Local Node</p>
