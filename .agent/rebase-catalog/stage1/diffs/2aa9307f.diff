+      // Per-key token quota accounting (single atomic UPDATE)
+      if (entry.apiKey && typeof entry.apiKey === "string") {
+        const totalTokens = promptTokens + completionTokens;
+        if (totalTokens > 0) {
+          const { incrementKeyTokens } = await import("./apiKeysRepo.js");
